# Macro for EMMA GEANT4 simulation

# Prepare beam
#---------------------------------------------------------------
/mydet/beamZ 6
/mydet/beamA 12
/mydet/beamCharge 4
/mydet/energy 4.1 MeV
/mydet/sigmaEnergy 0           # beam-energy resolution (sigma) in percent of beam energy
#/mydet/Angle 4.2 deg   	  # beam angle sampled uniformly between 0 and theta=sigmaAngle
#/mydet/beamSpotDiameter 1 mm
#/mydet/transEmittance 2.0 mm
#---------------------------------------------------------------
# Specify central trajectory
#----------------------------
/mydet/centralZ 6
/mydet/centralA 12
/mydet/centralQ 4
/mydet/centralE 5
/mydet/updategeo           # necessary for changes to take effect
#----------------------------

# Amount of output info
#-----------------------
/run/verbose      0
/event/verbose    0
/tracking/verbose 0
#-----------------------

# Run recoil simulation
#-----------------------
/mydet/nEvents 1000    
#/mydet/doPrepare
/mydet/doBeam
#/mydet/doReaction
