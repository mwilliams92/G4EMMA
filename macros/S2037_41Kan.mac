# Macro for EMMA GEANT4 simulation

# Prepare beam
#---------------------------------------------------------------
/mydet/beamZ 19	
/mydet/beamA 41
/mydet/beamCharge 12
/mydet/energy 82 MeV
/mydet/sigmaEnergy 0.01         # beam-energy resolution (sigma) in percent of beam energy
/mydet/Angle 0.0 deg   	  	# beam angle sampled uniformly between 0 and theta=sigmaAngle
/mydet/beamSpotDiameter 1.0 mm	# nominal: 1.0
/mydet/transEmittance 0.2 mm	# nominal: 0.2
#---------------------------------------------------------------

# Add nuclear-reaction process: 
# (Z1,A1)+(Z2,A2)->(Z3,A3)+(Z4,A4)
#-----------------------------------------
/twoBodyReaction/Z1 19         
/twoBodyReaction/A1 41         
/twoBodyReaction/Z2 2        
/twoBodyReaction/A2 4         
/twoBodyReaction/Z3 21         
/twoBodyReaction/A3 44         
/twoBodyReaction/Z4 0        
/twoBodyReaction/A4 1         
/twoBodyReaction/qmin 0.0   # minimum scattering angle in C.M. (deg)         
/twoBodyReaction/qmax 180.0   # maximum ...	   
/twoBodyReaction/Charge3 13   # charge state of fragment 3
/twoBodyReaction/ExcitationEnergy3 0.0    
#-----------------------------------------



# Specify central trajectory
#----------------------------
/mydet/centralZ 21
/mydet/centralA 44
/mydet/centralQ 13
/mydet/centralE 60.5
/mydet/updategeo           # necessary for changes to take effect
#----------------------------



# Amount of output info
#-----------------------
/run/verbose      0
/event/verbose    0
/tracking/verbose 0
#-----------------------


# Run simulation
#-----------------------
/mydet/nEvents 5000     
/mydet/doPrepare
/mydet/doBeam
/mydet/doReaction
#-----------------------


#-----------------------------------------
